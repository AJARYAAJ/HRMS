# Copy to .env in the project root (loaded automatically by npm start / npm run dev) or set these in your process manager.
PORT=4000
APP_URL=https://hr.example.com
JWT_SECRET=change-me-to-a-long-random-string
# DB_PATH=./server/data/hrms.db
# UPLOAD_DIR=./server/data/uploads
MAX_UPLOAD_MB=10

# Outgoing email. Leave SMTP_HOST empty to only record emails in Settings → Email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Example HR" <hr@example.com>
