# PeopleHub HRMS configuration. Copy to .env (cp .env.example .env) and edit.
# The server reads it on start (npm start / systemd / docker compose).

# ---- Required in production ----
NODE_ENV=production
# Random secret for sign-in tokens, at least 32 characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=
# Public address of the site (used in email links and installer scripts)
APP_URL=https://hr.example.com
# Domain for automatic HTTPS when using docker compose (must point at this server)
DOMAIN=hr.example.com

# ---- First start only: creates your organisation and the administrator account ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
COMPANY_NAME="Example Pvt. Ltd."
COMPANY_CITY=Bengaluru
COMPANY_STATE=Karnataka
# Load demo data instead (for a trial/demo server only — every demo user's password is Password@123)
# SEED_DEMO=1

# ---- Server ----
PORT=4000
# Behind Nginx/Caddy (the default deployment), trust the first proxy for client IPs and HTTPS detection
TRUST_PROXY=1
# DB_PATH=./server/data/hrms.db
# UPLOAD_DIR=./server/data/uploads
MAX_UPLOAD_MB=10
# Only needed if another website must call the API from the browser
# CORS_ORIGIN=https://intranet.example.com
# LOGIN_MAX_FAILURES=10

# ---- Outgoing email (leave SMTP_HOST empty to only record emails in Settings → Email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Example HR <hr@example.com>"

# ---- Browser & phone push notifications (optional) ----
# Keys are generated on first start and kept in the database, so push works without setting these.
# Set them only to keep the same keys across a fresh database (generate with: npx web-push generate-vapid-keys).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hr@example.com

# ---- Backups (npm run backup) ----
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
