# systemd unit for running PeopleHub directly on a VM (without Docker).
# Install: sudo cp deploy/peoplehub.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now peoplehub
[Unit]
Description=PeopleHub HRMS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peoplehub
Group=peoplehub
WorkingDirectory=/opt/peoplehub
Environment=NODE_ENV=production
Environment=TRUST_PROXY=1
EnvironmentFile=/opt/peoplehub/.env
ExecStart=/usr/bin/node --no-warnings server/src/index.js
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/peoplehub/server/data /opt/peoplehub/backups

[Install]
WantedBy=multi-user.target
