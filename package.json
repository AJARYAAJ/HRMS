{
  "name": "peoplehub-hrms",
  "version": "1.0.0",
  "private": true,
  "description": "PeopleHub HRMS - full-featured human resource management portal",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test:e2e": "npm run build && playwright test",
    "test:api": "npm test -w server",
    "agent:simulate": "node scripts/agent-simulator.mjs",
    "agent:build": "cd agent && go run ./tools/dist -out dist",
    "agent:test": "cd agent && go test ./...",
    "backup": "node --no-warnings scripts/backup.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "concurrently": "^9.2.1",
    "smtp-server": "^3.19.15"
  },
  "engines": {
    "node": ">=22.13"
  }
}
